# Stage 1: install dependencies — narrowed to server + happy-wire only
FROM node:20-slim AS deps

# No apt build deps needed — sharp ships prebuilt binaries, no other native deps in server.
# (If a node-gyp dep is added later, restore the apt install line from git history.)

WORKDIR /repo

COPY package.json yarn.lock ./
COPY scripts ./scripts
COPY patches ./patches

RUN mkdir -p packages/happy-server packages/happy-wire

COPY packages/happy-server/package.json packages/happy-server/
COPY packages/happy-wire/package.json packages/happy-wire/

# Narrow workspaces to server + happy-wire only.
# Skips happy-app (~8.6GB), happy-cli, happy-agent, happy-app-logs — none of which the server runtime needs.
# server depends on @slopus/happy-wire from v3 onward, so wire stays.
RUN node -e "const p=require('./package.json'); p.workspaces={packages:['packages/happy-server','packages/happy-wire'], nohoist:p.workspaces.nohoist}; require('fs').writeFileSync('package.json',JSON.stringify(p,null,2))"

# Workspace postinstall requirements (server only; happy-wire has none beyond its own deps)
COPY packages/happy-server/prisma packages/happy-server/prisma

# SKIP_HAPPY_WIRE_BUILD=1 defers wire build to Stage 2 where its source is present
RUN SKIP_HAPPY_WIRE_BUILD=1 yarn install --frozen-lockfile --ignore-engines

# Stage 2: build — happy-wire must build (pkgroll → dist/), server doesn't (tsc --noEmit is type-check only)
FROM deps AS builder

COPY packages/happy-wire ./packages/happy-wire
COPY packages/happy-server ./packages/happy-server

RUN yarn workspace @slopus/happy-wire build
# happy-server `build` is `tsc --noEmit` (type check); runtime uses tsx to interpret .ts directly, so skip here.

# Stage 3: runtime — pure Node, no apt
FROM node:20-slim AS runner

WORKDIR /repo

ENV NODE_ENV=production

COPY --from=builder /repo/node_modules /repo/node_modules
COPY --from=builder /repo/packages/happy-wire /repo/packages/happy-wire
COPY --from=builder /repo/packages/happy-server /repo/packages/happy-server

EXPOSE 3000

CMD ["yarn", "--cwd", "packages/happy-server", "start"]
